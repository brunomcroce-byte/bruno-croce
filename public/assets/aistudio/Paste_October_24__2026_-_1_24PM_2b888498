    function montarHtmlEditorialDeUmaPeca(p) {
      const nomesCor = { ROSA: "Rosa • Geral Todas as Peças", VERDE: "Verde • Tópico da Peça", AMARELO: "Amarelo • Direito Material" };
      const linhasQuesitos = p.quesitosFGV.map(q => `<tr><td>${q.item}</td><td style="text-align:center;"><span class="pilula pil-${q.cor}">${q.cor}</span></td><td style="text-align:center; font-weight:bold; color:#15803d;">${q.pts} pt</td></tr>`).join('');
      const cartoesBlocos = p.blocos.map(b => `<table class="card-bloco barra-${b.cor}"><tr><td style="padding: 12pt 14pt;"><table style="width:100%; border-collapse:collapse; margin-bottom:4pt;"><tr><td style="font-size:10.5pt; font-weight:bold; color:#334155;">${b.titulo}</td><td style="text-align:right;"><span class="pilula pil-${b.cor}">${nomesCor[b.cor] || b.cor}</span></td></tr></table><div class="dica-box">💡 <strong>Como pontuar na FGV:</strong> ${b.dica}</div><div class="texto-juridico">${b.texto.replace(/\n/g, '<br>')}</div></td></tr></table>`).join('');
      return `<div class="folha-word"><div class="cabecalho-peca"><span class="pilula pil-VERDE">${p.tipo} • ${p.examesCobrados}</span><div class="titulo-peca">${p.nome}</div><div class="subtitulo-peca">${p.baseLegal}</div></div><table class="tabela-quesitos"><thead><tr><th>Quesito Exigido no Espelho FGV</th><th style="width:90pt; text-align:center;">Cor no Vade</th><th style="width:70pt; text-align:center;">Pontos</th></tr></thead><tbody>${linhasQuesitos}</tbody></table>${cartoesBlocos}</div>`;
    }
