  <!-- MOTOR JAVASCRIPT GLOBAL -->
  <script>
    const memoriaRAM = {};
    const StorageSeguro = { get: function(chave, padrao) { try { const val = window.localStorage.getItem(chave); return val !== null ? val : padrao; } catch (e) { return memoriaRAM[chave] !== undefined ? memoriaRAM[chave] : padrao; } }, set: function(chave, valor) { try { window.localStorage.setItem(chave, valor); } catch (e) { memoriaRAM[chave] = valor; } } };

    let tarefasSemanaisConcluidas = JSON.parse(StorageSeguro.get('tributa_cronograma_v3', '[]'));
    let vadeMarcados = JSON.parse(StorageSeguro.get('tributa_vade_v1', '[]'));
    let pecaSelecionadaAtual = null;
    let corFiltroVade = 'TODAS';
    let idxFlash = 0, filtroCatFlashAtual = 'TODOS', listaFlashcardsFiltrada = [];

    function mudarAba(aba) {
      ['dashboard', 'cronograma', 'pecas', 'impostos', 'material', 'sumulas', 'simulador', 'flashcards', 'vademecum', 'legislacao', 'mapas', 'planner', 'teses'].forEach(a => { const sec = document.getElementById('aba-' + a); if (sec) sec.classList.add('hidden'); const btn = document.getElementById('nav-' + a); if (btn) btn.classList.remove('active'); });
      const secAtiva = document.getElementById('aba-' + aba); if (secAtiva) secAtiva.classList.remove('hidden');
      const btnAtivo = document.getElementById('nav-' + aba); if (btnAtivo) btnAtivo.classList.add('active');
    }

    function carregarPDFLocal(event, containerId) {
      const file = event.target.files[0];
      if (file && file.type === "application/pdf") { document.getElementById(containerId).innerHTML = `<iframe src="${URL.createObjectURL(file)}" width="100%" height="100%" style="border:none;"></iframe>`; }
      else { alert("Por favor, selecione um arquivo PDF válido."); }
    }

    function lerTextoEmVozAlta(texto) { if ('speechSynthesis' in window) { window.speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(texto); u.lang = 'pt-BR'; u.rate = 1.05; window.speechSynthesis.speak(u); } }
    function tocarAlarmeWebAudio() { try { const ctx = new (window.AudioContext || window.webkitAudioContext)(); [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => { const osc = ctx.createOscillator(); const gain = ctx.createGain(); osc.type = 'triangle'; osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.14); gain.gain.setValueAtTime(0.25, ctx.currentTime + idx * 0.14); gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.14 + 0.35); osc.connect(gain); gain.connect(ctx.destination); osc.start(ctx.currentTime + idx * 0.14); osc.stop(ctx.currentTime + idx * 0.14 + 0.35); }); } catch (err) {} }
    function testarAlarmeSonoro() { tocarAlarmeWebAudio(); lerTextoEmVozAlta("Sistema em funcionamento!"); }

    let minPomodoro = 50, segPomodoro = 0, intervaloPomodoro = null;
    function iniciarCobrador() { if (intervaloPomodoro) { clearInterval(intervaloPomodoro); intervaloPomodoro = null; document.getElementById('btnIniciarTimer').innerText = "Retomar"; return; } tocarAlarmeWebAudio(); document.getElementById('btnIniciarTimer').innerText = "Pausar"; intervaloPomodoro = setInterval(() => { if (segPomodoro === 0) { if (minPomodoro === 0) { clearInterval(intervaloPomodoro); intervaloPomodoro = null; alert('Foco Finalizado!'); tocarAlarmeWebAudio(); return; } minPomodoro--; segPomodoro = 59; } else { segPomodoro--; } document.getElementById('pomodoroDisplay').innerText = String(minPomodoro).padStart(2,'0') + ':' + String(segPomodoro).padStart(2,'0'); }, 1000); }
    function resetarCobrador() { if(intervaloPomodoro) { clearInterval(intervaloPomodoro); intervaloPomodoro = null; } minPomodoro = 50; segPomodoro = 0; document.getElementById('pomodoroDisplay').innerText = "50:00"; document.getElementById('btnIniciarTimer').innerText = "Iniciar 50m"; }

    let segundosProva5h = 5 * 3600, intervaloProva5h = null;
    function toggleTimerProva() { const btn = document.getElementById('btnToggleTimerProva'); if (intervaloProva5h) { clearInterval(intervaloProva5h); intervaloProva5h = null; if (btn) btn.innerText = "Retomar 5h"; return; } if (btn) btn.innerText = "Pausar 5h"; intervaloProva5h = setInterval(() => { if (segundosProva5h > 0) { segundosProva5h--; const h = String(Math.floor(segundosProva5h / 3600)).padStart(2, '0'); const m = String(Math.floor((segundosProva5h % 3600) / 60)).padStart(2, '0'); const s = String(segundosProva5h % 60).padStart(2, '0'); document.getElementById('timerProva5h').innerText = h + ":" + m + ":" + s; } else { clearInterval(intervaloProva5h); intervaloProva5h = null; tocarAlarmeWebAudio(); } }, 1000); }
